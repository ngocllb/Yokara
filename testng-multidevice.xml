<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- parallel=tests: Android + iOS cùng lúc; driver theo ThreadLocal + cổng riêng mỗi session -->
<suite name="Yokara Multi-Device (USB thật)" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="Android-USB">
        <parameter name="suitePlatform" value="android"/>
        <classes>
            <class name="tests.NavigationTest"/>
            <class name="tests.LoginMethodTest"/>
            <class name="tests.RoomTest"/>
        </classes>
    </test>

    <test name="iOS-USB">
        <parameter name="suitePlatform" value="ios"/>
        <classes>
            <class name="tests.NavigationTest"/>
            <class name="tests.LoginMethodTest"/>
            <class name="tests.RoomTest"/>
        </classes>
    </test>
</suite>
