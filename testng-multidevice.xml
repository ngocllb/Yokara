<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- none: cùng một máy + một iPhone → không chạy 2 session Appium song song (WDA/tab bar flake). Jenkins nhiều agent: tách job hoặc dùng profile parallel riêng. -->
<suite name="Yokara Multi-Device (USB thật)" parallel="none">

    <!-- AllureTestNg: auto SPI từ dependency allure-testng — chỉ giữ listener tùy chỉnh -->
    <listeners>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="Android-USB">
        <parameter name="suitePlatform" value="android"/>
        <classes>
            <class name="tests.RoomTest"/>
        </classes>
    </test>

    <test name="iOS-USB">
        <parameter name="suitePlatform" value="ios"/>
        <classes>
            <class name="tests.RoomTest"/>
        </classes>
    </test>
</suite>
