<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke song song Android + iOS: chỉ 1 method / nền để kiểm tra pipeline nhanh -->
<suite name="Yokara smoke parallel (USB)" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="Android-smoke">
        <parameter name="suitePlatform" value="android"/>
        <classes>
            <class name="tests.NavigationTest">
                <methods>
                    <include name="testNavigateToToi"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="iOS-smoke">
        <parameter name="suitePlatform" value="ios"/>
        <classes>
            <class name="tests.NavigationTest">
                <methods>
                    <include name="testNavigateToToi"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
