<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Yokara iOS Suite" parallel="false">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="iOS-USB">
        <parameter name="suitePlatform" value="ios"/>
        <classes>
            <class name="tests.NavigationTest"/>
            <class name="tests.LoginMethodTest"/>
            <class name="tests.RoomTest"/>
        </classes>
    </test>

</suite>
