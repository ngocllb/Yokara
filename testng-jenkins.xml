<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Yokara Jenkins Suite" parallel="none">
    
    <!-- AllureTestNg được nạp tự động từ allure-testng (SPI); không khai báo thêm để tránh duplicate listener -->
    <listeners>
        <listener class-name="listeners.AllureListener"/>
    </listeners>

    <test name="Jenkins Automated Tests">
        <classes>
            <class name="tests.RoomTest"/>
        </classes>
    </test>
</suite>
